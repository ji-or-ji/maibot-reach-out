{
  "manifest_version": 2,
  "id": "ji-or-ji.maibot-reach-out",
  "version": "1.0.0",
  "name": "麦麦主动私聊 Pro",
  "description": "让麦麦主动找人说话，并且知道自己为什么来。受人所托时带着由头开口，走神时忽然想起某人就说一句。支持触发者白名单、目标黑白名单、每人每日次数与间隔、时段窗口，生成内容不出现「有人让我」「带话」这类字样。",
  "author": {
    "name": "ji-or-ji",
    "url": "https://github.com/ji-or-ji"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/ji-or-ji/maibot-reach-out",
    "homepage": "https://github.com/ji-or-ji/maibot-reach-out",
    "documentation": "https://github.com/ji-or-ji/maibot-reach-out/blob/main/README.md",
    "issues": "https://github.com/ji-or-ji/maibot-reach-out/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.9.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.9.99"
  },
  "plugin_type": "chat",
  "dependencies": [],
  "capabilities": [
    "send.text",
    "chat.get_private_streams",
    "chat.get_group_streams",
    "chat.get_stream_by_user_id",
    "chat.open_session",
    "api.call",
    "message.get_recent",
    "config.get",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
